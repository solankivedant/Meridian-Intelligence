generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  RSS
  API
  SCRAPE
}

// Whether a story is about India or the rest of the world. Both share the same
// eight categories; only the desk they belong to differs.
enum Region {
  INDIA
  WORLD
}

enum Category {
  POLICY_REGULATORY
  SUBSIDY_SCHEME
  BUSINESS_STARTUP
  TECH_INNOVATION
  ECONOMY_MARKETS
  INVESTMENT_FDI
  TRADE_IMPORT_EXPORT
  GEOPOLITICS
}

model Source {
  id              String     @id @default(cuid())
  name            String     @unique
  url             String
  type            SourceType
  defaultCategory Category
  region          Region     @default(INDIA)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  articles        Article[]
}

model Article {
  id          String   @id @default(cuid())
  title       String
  excerpt     String   @db.Text
  url         String   @unique
  category    Category
  region      Region   @default(INDIA)
  tags        String[]
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id])

  @@index([category, publishedAt])
  @@index([publishedAt])
  @@index([region, publishedAt])
  @@index([region, category, publishedAt])
}

model DailyBrief {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  highlights  Json
  // Gemini's written wrap for the day: { overview, points[], model,
  // generatedAt }. Null whenever summarisation was unconfigured or failed —
  // the highlight list above stands on its own. See lib/summarize.ts.
  summary     Json?
  generatedAt DateTime @default(now())
}
