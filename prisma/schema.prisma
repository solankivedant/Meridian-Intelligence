generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SourceType {
  RSS
  API
  SCRAPE
}

// Whether a story is about India or the rest of the world. Both share the same
// eight categories; only the desk they belong to differs.
enum Region {
  INDIA
  WORLD
}

enum Category {
  POLICY_REGULATORY
  SUBSIDY_SCHEME
  BUSINESS_STARTUP
  TECH_INNOVATION
  ECONOMY_MARKETS
  INVESTMENT_FDI
  TRADE_IMPORT_EXPORT
  GEOPOLITICS
}

model Source {
  id              String     @id @default(cuid())
  name            String     @unique
  url             String
  type            SourceType
  defaultCategory Category
  region          Region     @default(INDIA)
  active          Boolean    @default(true)
  createdAt       DateTime   @default(now())
  articles        Article[]
}

model Article {
  id          String   @id @default(cuid())
  title       String
  excerpt     String   @db.Text
  url         String   @unique
  category    Category
  region      Region   @default(INDIA)
  tags        String[]
  // Companies named in the headline or excerpt, resolved against the curated
  // dictionary in `lib/entities.ts`. Stored rather than matched at read time
  // for the same reason `tags` is: it costs nothing at ingest and keeps a
  // company page a plain indexed array query instead of a scan over prose.
  entities    String[]
  publishedAt DateTime
  fetchedAt   DateTime @default(now())

  // Likes are a property of the story, not of a reader: this site has no
  // accounts, so there is nobody to attribute one to and nothing to scope a
  // per-reader table by. The counter is the whole record - every reader sees
  // the same number, and which stories a given browser has liked is kept in
  // that browser (see lib/likes.ts) purely so the button can show its state
  // and be pressed again to take it back.
  likes Int @default(0)

  sourceId String
  source   Source @relation(fields: [sourceId], references: [id])

  // Declared here as well as in `20260818020834_region_and_search`, which
  // created it by hand: left out of the schema, every later `migrate dev` diffs
  // it as an index that should not exist and writes a DROP for it. Sector
  // filters are `tags && ARRAY[...]`, which without this is a sequential scan.
  @@index([tags], type: Gin)
  // Same reasoning as the line above, for `entities && ARRAY[...]`.
  @@index([entities], type: Gin)
  @@index([category, publishedAt])
  @@index([publishedAt])
  @@index([region, publishedAt])
  @@index([region, category, publishedAt])
}

model DailyBrief {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date
  highlights  Json
  // Gemini's written wrap for the day: { overview, points[], model,
  // generatedAt }. Null whenever summarisation was unconfigured or failed -
  // the highlight list above stands on its own. See lib/summarize.ts.
  summary     Json?
  generatedAt DateTime @default(now())
}
